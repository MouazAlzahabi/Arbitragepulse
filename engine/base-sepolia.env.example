# ─── ArbitragePulse — Base Sepolia (testing stage) instance ─────────────────────────────────
# Copy to engine/base-sepolia.env (gitignored) and fill in. Used by the systemd unit
# arbitragepulse@base-sepolia; one engine instance per chain, so every instance has its own
# config, port, database and (ideally) wallet.

# Wallet private key (with 0x prefix). Use a separate TESTNET-ONLY key, never the production one.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Alchemy API key — substituted into ${ALCHEMY_KEY} in the config's RPC URLs
ALCHEMY_KEY=YOUR_ALCHEMY_KEY_HERE

# This instance's chain config (absolute, or relative to the working directory)
CONFIG_PATH=engine/config-testnet.yaml

# API/dashboard port — different per instance on the same server
PORT=3001

# SQLite trade database — different per instance
DB_PATH=trades-base-sepolia.db

# Bearer token for the HTTP API (empty = no auth)
API_KEY=

LOG_LEVEL=info

# Dry-run (simulate only). Start true; set false only after a clean dry-run period.
DRY_RUN=true
