# ============================================================
# ArbitragePulse Engine — Secrets Only
# Chain config, routers, and pairs are in config.yaml
# ============================================================

# Wallet private key (same key deploys + operates across all chains)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Config file path (default: config.yaml)
CONFIG_PATH=config.yaml

# Token allowlist file (default: tokens.yaml)
TOKENS_PATH=tokens.yaml

# Contract address (fallback — per-chain addresses should be in config.yaml)
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Server port
PORT=3000

# API key for dashboard authentication.
# Generate one: openssl rand -hex 32
# If empty, auth is disabled (OK for local dev, NOT for Hetzner).
API_KEY=

# Log level: debug, info, warn, error
LOG_LEVEL=info
