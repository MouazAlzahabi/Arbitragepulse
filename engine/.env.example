# ─── ArbitragePulse Engine — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Your wallet private key (with 0x prefix)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Alchemy API key (substituted into ${ALCHEMY_KEY} in the config's RPC URLs)
ALCHEMY_KEY=YOUR_ALCHEMY_KEY_HERE

# Engine config file path (absolute or relative to where you run cargo).
# One chain per instance: engine/config.yaml (Base) or engine/config-testnet.yaml (Base Sepolia).
CONFIG_PATH=engine/config.yaml

# SQLite trade database (one per instance)
DB_PATH=trades.db

# Server port (default: 3000)
PORT=3000

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# Dry-run mode: set to false to enable live execution (default: true = safe)
DRY_RUN=true
