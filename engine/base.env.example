# ─── ArbitragePulse — Base mainnet (production) instance ─────────────────────────────────
# Copy to engine/base.env (gitignored) and fill in. Used by the systemd unit
# arbitragepulse@base; one engine instance per chain, so every instance has its own
# config, port, database and (ideally) wallet.

# Wallet private key (with 0x prefix). Production funds — keep this file root/botadmin only (chmod 600).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Must be the executor contract's owner — the engine checks owner() at startup and exits (code 2) otherwise.

# Alchemy API key — substituted into ${ALCHEMY_KEY} in the config's RPC URLs
ALCHEMY_KEY=YOUR_ALCHEMY_KEY_HERE

# This instance's chain config (absolute, or relative to the working directory)
CONFIG_PATH=engine/config.yaml

# API/dashboard port — different per instance on the same server
PORT=3000

# SQLite trade database — different per instance
DB_PATH=trades-base.db

# Bearer token for the HTTP API and dashboard — REQUIRED. The engine refuses to start
# with an empty API_KEY (exit code 2) unless API_INSECURE=1 is set, which leaves every
# route (dry-run toggle, restart, stats reset) open — local development only.
# Generate one with: openssl rand -hex 32
API_KEY=

LOG_LEVEL=info

# Dry-run (simulate only). Start true; set false only after a clean dry-run period.
DRY_RUN=true
