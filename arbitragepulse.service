[Unit]
Description=ArbitragePulse Multi-Chain Engine
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=botadmin
WorkingDirectory=/home/botadmin/Arbitragepulse
EnvironmentFile=/home/botadmin/Arbitragepulse/engine/.env
ExecStart=/home/botadmin/Arbitragepulse/target/release/engine
Restart=always
RestartSec=10
StandardOutput=append:/var/log/arbitragepulse/engine.log
StandardError=append:/var/log/arbitragepulse/engine.log

[Install]
WantedBy=multi-user.target
