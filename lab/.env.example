# ============================================================
# ArbitragePulse Lab — Simulation Environment
# ============================================================

# RPC to fork from (Alchemy/QuickNode HTTP URL)
# This is READ-ONLY — no gas spent, we fork the state locally
FORK_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Chain to fork: optimism | base | gnosis
FORK_CHAIN=optimism

# Local Anvil URL (default)
ANVIL_URL=http://127.0.0.1:8545

# Test wallet private key — Anvil default account #0
# This is a well-known test key, NEVER use on mainnet
TEST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Path to compiled ArbitrageExecutor contract artifact
# Foundry: forge build → out/ArbitrageExecutor.sol/ArbitrageExecutor.json
# Foundry: cd ../contract && forge build
CONTRACT_ARTIFACT_PATH=../contract/out/ArbitrageExecutor.sol/ArbitrageExecutor.json
