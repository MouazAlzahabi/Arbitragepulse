# ArbitragePulse — one engine instance per chain (systemd template unit).
#
# The instance name selects the env file: arbitragepulse@base reads engine/base.env,
# arbitragepulse@base-sepolia reads engine/base-sepolia.env. Each env file sets its own
# CONFIG_PATH, PORT, DB_PATH, PRIVATE_KEY, DRY_RUN, API_KEY and ALCHEMY_KEY.
#   sudo systemctl enable --now arbitragepulse@base
[Unit]
Description=ArbitragePulse arbitrage engine (%i)
After=network-online.target
Wants=network-online.target
# Allow up to 5 rapid restarts in 2 min before systemd gives up
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=botadmin
WorkingDirectory=/home/botadmin/Arbitragepulse
EnvironmentFile=/home/botadmin/Arbitragepulse/engine/%i.env
ExecStart=/home/botadmin/Arbitragepulse/target/release/engine

# Restart on crash/error — not on clean exit (SIGTERM from systemctl stop).
# A chain-id mismatch (wrong RPC for the config) exits 2 and is not retried.
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5

# Graceful shutdown: send SIGTERM, wait 30s, then SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=30

# Logs (one file per instance)
StandardOutput=append:/var/log/arbitragepulse/%i.log
StandardError=append:/var/log/arbitragepulse/%i.log

# Resource guards — prevents a runaway engine from taking down the whole server
MemoryMax=2G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
