[Unit]
Description=ArbitragePulse Multi-Chain Arbitrage Engine
After=network-online.target
Wants=network-online.target
# Allow up to 5 rapid restarts in 2 min before systemd gives up
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=botadmin
WorkingDirectory=/home/botadmin/Arbitragepulse
EnvironmentFile=/home/botadmin/Arbitragepulse/engine/.env
ExecStart=/home/botadmin/Arbitragepulse/target/release/engine

# Restart on crash/error — not on clean exit (SIGTERM from systemctl stop)
Restart=on-failure
RestartSec=5

# Graceful shutdown: send SIGTERM, wait 30s, then SIGKILL
KillSignal=SIGTERM
TimeoutStopSec=30

# Logs
StandardOutput=append:/var/log/arbitragepulse/engine.log
StandardError=append:/var/log/arbitragepulse/engine.log

# Resource guards — prevents a runaway engine from taking down the whole server
MemoryMax=2G
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
