[Unit]
Description=ArbitragePulse Watchdog — runs every 30 seconds
Requires=ap-watchdog.service

[Timer]
# First run 60 s after boot (give engine time to start)
OnBootSec=60
# Then every 30 s from the previous run completion
OnUnitActiveSec=30
Unit=ap-watchdog.service
# Don't pile up missed runs if system was suspended
AccuracySec=5

[Install]
WantedBy=timers.target
