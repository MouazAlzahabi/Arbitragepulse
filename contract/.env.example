# ============================================================
# ArbitrageExecutor — Foundry Config
# ============================================================

# Deployer wallet private key
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# RPC endpoints (HTTP)
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# Etherscan API V2 key (etherscan.io account) — verifies on Base and Base Sepolia.
# Needs Foundry >= 1.3 (V2 is the default there; older forge talks to the retired BaseScan V1 API).
ETHERSCAN_API_KEY=
